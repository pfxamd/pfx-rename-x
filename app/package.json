{
  "name": "@pfxamd/rename-x-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "build:pages": "tsc -p tsconfig.json && vite build --mode pages",
    "e2e:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@pfxamd/rename-x": "file:..",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "^3.2.4"
  }
}
